<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>
  <template class="TypesetterManageTemplatesDialog" parent="AdwDialog">
    <property name="title" translatable="yes">Packages</property>
    <property name="content-width">640</property>
    <child>
      <object class="AdwBreakpointBin">
        <property name="width-request">360</property>
        <property name="height-request">150</property>
        <property name="child">
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
              <object class="AdwToolbarView">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <child type="start">
                      <object class="GtkMenuButton" id="import_button">
                        <property name="icon-name">list-add-symbolic</property>
                        <property name="always-show-arrow">true</property>
                        <property name="tooltip-text" translatable="yes">Install Package</property>
                        <property name="menu-model">import_menu</property>
                        <style>
                          <class name="flat"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <property name="content">
                  <object class="AdwPreferencesPage">
                    <child>
                      <object class="AdwPreferencesGroup" id="installed_group">
                        <property name="title" translatable="yes">Installed</property>
                        <child>
                          <object class="AdwActionRow" id="installed_placeholder">
                            <property name="title" translatable="yes">No installed packages</property>
                            <property name="halign">center</property>
                            <property name="activatable">false</property>
                            <style>
                              <class name="dimmed"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="cached_group">
                        <property name="title" translatable="yes">Cached</property>
                        <child>
                          <object class="AdwActionRow" id="cached_placeholder">
                            <property name="title" translatable="yes">No cached packages</property>
                            <property name="halign">center</property>
                            <property name="activatable">false</property>
                            <style>
                              <class name="dimmed"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="AdwPreferencesGroup" id="bundled_group">
                        <property name="title" translatable="yes">Built-in</property>
                        <child>
                          <object class="AdwActionRow" id="bundled_placeholder">
                            <property name="title" translatable="yes">No built-in packages</property>
                            <property name="halign">center</property>
                            <property name="activatable">false</property>
                            <style>
                              <class name="dimmed"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </child>
  </template>
  <menu id="import_menu">
    <item>
      <attribute name="label" translatable="yes">Install From Archive</attribute>
      <attribute name="action">dialog.import-archive</attribute>
    </item>
    <item>
      <attribute name="label" translatable="yes">Install From Folder</attribute>
      <attribute name="action">dialog.import-folder</attribute>
    </item>
    <!-- <item> -->
    <!--   <attribute name="label" translatable="yes">Install From Repository</attribute> -->
    <!--   <attribute name="action">dialog.import-git</attribute> -->
    <!-- </item> -->
  </menu>
</interface>
