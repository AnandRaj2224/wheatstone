#: data/net.trowell.typesetter.gschema.xml:18
msgid "Check Grammar"
msgstr "Revisar Gramática"

#: data/net.trowell.typesetter.gschema.xml:19
msgid "Whether to enable grammar checking in the editor."
msgstr "Indica si se debe habilitar la comprobación de sintaxis en el editor."

#: data/net.trowell.typesetter.gschema.xml:23
msgid "Check Spelling"
msgstr "Revisar Ortografía"

#: data/net.trowell.typesetter.gschema.xml:24
msgid "Whether to enable spellcheck in the editor."
msgstr "Habilitar el corrector ortográfico en el editor."

#: data/net.trowell.typesetter.gschema.xml:29
msgid "Whether to highlight the current line in the editor."
msgstr "Resaltar la línea actual en el editor."

#: data/net.trowell.typesetter.gschema.xml:33
msgid "Invert Lightness"
msgstr "Invertir Luminosidad"

#: data/net.trowell.typesetter.gschema.xml:34
msgid ""
"Whether to invert the lightness of pages in the preview when dark mode is "
"enabled."
msgstr ""
"Invertir la luminosidad en la prevista de las páginas cuando el modo oscuro "
"está habilitado."

#: data/net.trowell.typesetter.gschema.xml:57
msgid "PDF Standard"
msgstr "Estándar PDF"

#: data/net.trowell.typesetter.gschema.xml:58
msgid "The PDF standard to use when exporting."
msgstr "El estándar PDF que se usará al exportar."

#: data/net.trowell.typesetter.gschema.xml:62
msgid "Scroll Preview on Type"
msgstr "Desplazar Previsualización al Digitar"

#: data/net.trowell.typesetter.gschema.xml:63
msgid ""
"Whether to automatically scroll the preview to the current position in the "
"editor."
msgstr ""
"Desplazar automáticamente la prevista a la posición actual en el editor."

#: data/net.trowell.typesetter.gschema.xml:67
msgid "Show Built-in Templates"
msgstr "Mostrar plantillas integradas"

#: data/net.trowell.typesetter.gschema.xml:68
msgid "Whether to show bundled templates in the template picker."
msgstr "Mostrar o no las plantillas incluidas en el selector de plantillas."

